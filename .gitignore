# Dependencies
**/node_modules/

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example

# Next.js / frontend build output
front-end/.next/
front-end/out/
front-end/build/
front-end/.vercel/

# TypeScript
**/*.tsbuildinfo

# Test and coverage output
**/coverage/
**/.nyc_output/

# Backend generated files
back-end/uploads/*
!back-end/uploads/.gitkeep

# Logs and debug files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Local databases and generated data
**/*.sqlite
**/*.sqlite3
**/*.db

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Certificates and private keys
**/*.pem
**/*.key
